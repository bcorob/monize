# Environment variables
.env
.env.*
!.env.example

# Dependencies
# Both forms on purpose: `node_modules/` matches the real directory, and the
# bare name also matches a *symlink* called node_modules -- which is how a git
# worktree shares one install with the main checkout, and how two of them got
# committed by an `add` with an explicit pathspec.
node_modules/
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Docker
docker-compose.override.yml

